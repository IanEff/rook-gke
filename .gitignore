# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files
*.tfvars
*.tfvars.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Personal Claude Code permission overrides (not team-wide policy) and runtime state
.claude/settings.local.json
.claude/scheduled_tasks.lock
