terraform {
  required_version = ">= 1.6.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 3.0"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 3.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

# A raw ADC bearer token (data.google_client_config.default.access_token) made both the
# kubernetes and helm providers hang indefinitely on the simplest possible write (a bare
# StorageClass create, no wait/rollout logic involved) -- reproduced identically across
# provider versions 2.x and 3.x and across two independently-recreated clusters, so it
# wasn't a stale cluster or a provider bug. kubectl, using gke-gcloud-auth-plugin's
# exec-based auth the whole time, never once hung. Switching both providers to the same
# exec plugin instead of a static token.
provider "kubernetes" {
  host                   = "https://${google_container_cluster.primary.endpoint}"
  cluster_ca_certificate = base64decode(google_container_cluster.primary.master_auth[0].cluster_ca_certificate)
  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "gke-gcloud-auth-plugin"
  }
}

provider "helm" {
  kubernetes = {
    host                   = "https://${google_container_cluster.primary.endpoint}"
    cluster_ca_certificate = base64decode(google_container_cluster.primary.master_auth[0].cluster_ca_certificate)
    exec = {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "gke-gcloud-auth-plugin"
    }
  }
}
